<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypoZen - WYSIWYG Markdown &amp; Text Editor" Height="780" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#0F172A" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Fluent surface tokens (overwritten per-theme by ApplyThemeChrome) -->
        <SolidColorBrush x:Key="TzSubtleHoverBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="TzSubtlePressedBrush" Color="#1EFFFFFF"/>
        <SolidColorBrush x:Key="TzSubtleFillBrush" Color="#0CFFFFFF"/>
        <SolidColorBrush x:Key="TzHairlineBorderBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="TzPopupBgBrush" Color="#202024"/>
        <SolidColorBrush x:Key="TzMutedTextBrush" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="TzAccentHoverBrush" Color="#343B82F6"/>
        <SolidColorBrush x:Key="TzAccentPressedBrush" Color="#443B82F6"/>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuBarBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource TzPopupBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TzHairlineBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" Opacity="0.35" ShadowDepth="4" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Submenu Item Template -->
        <ControlTemplate x:Key="SubmenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="templateRoot" Background="Transparent" CornerRadius="4" Padding="10,6" Margin="2,1" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <ContentPresenter x:Name="iconPresenter" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="checkMark" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                    <ContentPresenter x:Name="headerPresenter" Grid.Column="1" ContentSource="Header" Margin="4,0,16,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    
                    <TextBlock x:Name="gestureText" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="16,0,4,0" VerticalAlignment="Center" Opacity="0.6"/>
                    <TextBlock x:Name="subMenuArrow" Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Margin="16,0,4,0" VerticalAlignment="Center" Visibility="Collapsed" Opacity="0.6"/>

                    <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" Focusable="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border x:Name="SubMenuBorder" Background="{DynamicResource TzPopupBgBrush}" BorderBrush="{DynamicResource TzHairlineBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="4,0,8,8" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" Opacity="0.35" ShadowDepth="4" Color="#000000"/>
                            </Border.Effect>
                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter TargetName="gestureText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="subMenuArrow" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource TzAccentHoverBrush}"/>
                    <Setter TargetName="gestureText" Property="Opacity" Value="0.85"/>
                    <Setter TargetName="subMenuArrow" Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="templateRoot" Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Top Level Header Template -->
        <ControlTemplate x:Key="TopLevelHeaderTemplate" TargetType="MenuItem">
            <Border x:Name="templateRoot" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="4" Padding="7,4" Margin="1,0" SnapsToDevicePixels="True">
                <Grid>
                    <ContentPresenter x:Name="headerPresenter" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" Focusable="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border x:Name="SubMenuBorder" Background="{DynamicResource TzPopupBgBrush}" BorderBrush="{DynamicResource TzHairlineBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,8,8" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" Opacity="0.35" ShadowDepth="4" Color="#000000"/>
                            </Border.Effect>
                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource TzAccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource TzAccentPressedBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="MenuItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource TopLevelHeaderTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource TopLevelHeaderTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- The star on a row of File > Open Recent. Tag "on" is a favourite: always shown, in the
             accent colour, which every theme keeps readable against the menu. A recent file's
             outline star shows only on the highlighted row, where the row's own text colour is
             the one that reads against the accent. -->
        <Style x:Key="RecentStarButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="10,-3,-12,-3"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="back" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="back" Property="Background" Value="{DynamicResource TzSubtleHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHighlighted, RelativeSource={RelativeSource AncestorType=MenuItem}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="on"/>
                        <Condition Binding="{Binding IsHighlighted, RelativeSource={RelativeSource AncestorType=MenuItem}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}"/>
                </MultiDataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource TzHairlineBorderBrush}"/>
            <Setter Property="Margin" Value="10,4,10,4"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" Margin="{TemplateBinding Margin}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource TzSubtleFillBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TzHairlineBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource TzSubtleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource TzSubtlePressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="capBorder" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="capBorder" Property="Background" Value="{DynamicResource TzSubtleHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="capBorder" Property="Background" Value="{DynamicResource TzSubtlePressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="capBorder" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="capBorder" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="capBorder" Property="Background" Value="#B22215"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Background" Value="{DynamicResource TzHairlineBorderBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <!-- Quiet format tools & Fluent segmented pill controls. -->
        <Style x:Key="SegmentGroup" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TzSubtleFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TzHairlineBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- A single two-state toolbar button: shows the current value, flips on click. -->
        <Style x:Key="ToolbarStateButton" TargetType="Button">
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource TzSubtleFillBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TzHairlineBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="stateBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                    <Condition Property="Tag" Value="{x:Null}"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="stateBorder" Property="Background" Value="{DynamicResource TzSubtleHoverBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="stateBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource TzHairlineBorderBrush}"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="1,0"/>
        </Style>

        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="segBorder" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                Margin="0" MinHeight="{TemplateBinding MinHeight}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover only reads on segments the user can actually act on. -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                    <Condition Property="Tag" Value="{x:Null}"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="segBorder" Property="Background" Value="{DynamicResource TzSubtleHoverBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="segBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="{x:Null}"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource TzSubtleHoverBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource TzSubtlePressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
        </Style>
    </Window.Resources>

    <!--
      rootChrome: full window. contentRoot inset leaves a thin WPF strip around the edges
      so WindowChrome resize works. WebView2 (WinForms HWND) otherwise covers the client
      and steals edge hits — only corners/status bar used to resize.
    -->
    <Grid x:Name="rootChrome">
    <DockPanel x:Name="contentRoot" Margin="6">
        <!--
          Notepad-style chrome (Option B):
            tabBar — title-bar band: document tabs + custom min/max/close
            topToolbar — command row: File/Edit/… + Read Aloud, Mode, Columns, Scroll
          WindowChrome is applied from C#. Empty title space must NOT be hit-testable in
          chrome so the window can be dragged; only tabs and caption buttons opt in.
        -->
        <!--
          Seam is a Rectangle BEHIND the tabs (not Border.BorderThickness). That way the
          active tab can paint over the line; a Border's stroke sits outside the child
          arrange rect and can never be covered.
        -->
        <Border x:Name="tabBar" DockPanel.Dock="Top" Height="36" BorderThickness="0" Padding="8,0,0,0"
                ClipToBounds="False">
            <Grid ClipToBounds="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Full-width seam under the tab row; themed in C#. -->
                <Rectangle x:Name="tabSeam" Grid.Column="0" Grid.ColumnSpan="2"
                           Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
                <!-- Notepad-style: no fat Auto scrollbar in the title band. Overflow uses
                     shrink-to-fit + mouse-wheel / optional arrow scroll (wired in C#). -->
                <Grid Grid.Column="0" Margin="0,0,4,0" ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnTabScrollLeft" Grid.Column="0" Style="{StaticResource GhostToolbarButton}"
                            Content="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                            Width="24" MinWidth="24" MinHeight="24" Height="24" Padding="0"
                            VerticalAlignment="Top" Margin="0,5,2,0"
                            ToolTip="Scroll tabs left" Visibility="Collapsed"/>
                    <ScrollViewer x:Name="tabScroller" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False" VerticalAlignment="Stretch"
                                  ClipToBounds="False" PanningMode="HorizontalOnly">
                        <StackPanel x:Name="tabStrip" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,5,0,0"/>
                    </ScrollViewer>
                    <Button x:Name="btnTabScrollRight" Grid.Column="2" Style="{StaticResource GhostToolbarButton}"
                            Content="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                            Width="24" MinWidth="24" MinHeight="24" Height="24" Padding="0"
                            VerticalAlignment="Top" Margin="2,5,0,0"
                            ToolTip="Scroll tabs right" Visibility="Collapsed"/>
                </Grid>
                <StackPanel x:Name="captionButtons" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Stretch">
                    <Button x:Name="btnWinMin" Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" ToolTip="Minimize"/>
                    <Button x:Name="btnWinMax" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;" ToolTip="Maximize"/>
                    <Button x:Name="btnWinClose" Style="{StaticResource CloseCaptionButtonStyle}" Content="&#xE8BB;" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="topToolbar" DockPanel.Dock="Top" BorderThickness="0,0,0,1" Padding="6,4,8,4">
            <Grid>
               <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Button x:Name="btnToggleSidebar" Style="{StaticResource GhostToolbarButton}"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE8A0;" FontSize="14"
                            MinWidth="30" Padding="6,2" Margin="0"
                            ToolTip="Toggle Outline and Search Sidebar (Alt+\)"/>
                    <Border Style="{StaticResource ToolbarDivider}"/>
                    <Menu x:Name="topMenu" Background="Transparent" Padding="0" VerticalAlignment="Center">
                        <MenuItem Header="_File">
                            <MenuItem x:Name="mNew" Header="_New" InputGestureText="Ctrl+N"/>
                            <MenuItem x:Name="mOpen" Header="_Open..." InputGestureText="Ctrl+O"/>
                            <MenuItem x:Name="mOpenExternal" Header="Open in _Default App"
                                      ToolTip="Open this file in whatever Windows uses for it -- for a PDF, your usual PDF reader"/>
                            <MenuItem x:Name="mRecentMenu" Header="Open _Recent">
                                <MenuItem Header="(none)" IsEnabled="False"/>
                                <Separator/>
                                <MenuItem x:Name="mRecentEnabled" Header="_Keep recent files list" IsCheckable="True" IsChecked="True"
                                          ToolTip="Off: TypoZen stops listing the files you open, and forgets the list. Privacy Mode turns it off too."/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem x:Name="mSave" Header="_Save" InputGestureText="Ctrl+S"/>
                            <MenuItem x:Name="mSaveAs" Header="Save _As..." InputGestureText="Ctrl+Shift+S"/>
                            <Separator/>
                            <MenuItem x:Name="mExportHtml" Header="Export as _HTML..."/>
                            <MenuItem x:Name="mExportPdf" Header="_Print / Export PDF..." InputGestureText="Ctrl+P"/>
                            <MenuItem x:Name="mSavePdfPages" Header="Save Pa_ges as Images..."
                                      ToolTip="Save pages of this PDF as PNG or JPEG pictures, at the resolution you choose"/>
                            <MenuItem x:Name="mSavePdfImages" Header="Save All _Images in PDF..."
                                      ToolTip="Save every picture in this PDF as its own file -- photos keep their original quality"/>
                            <Separator/>
                            <!-- Off by default: with it on, closing without saving stops
                                 being a way to discard an experiment, which is a decision
                                 about the reader's own files. Only ever saves a document
                                 that already has a path — an unattended save must never
                                 raise a Save As dialog. -->
                            <MenuItem x:Name="mAutosave" Header="A_utosave" IsCheckable="True" IsChecked="False"
                                      ToolTip="Save a moment after typing stops. Only for documents that already have a file."/>
                            <!-- Filled in code from what is on disk, and again each time File
                                 opens: the built-in dictionary, then every folder under the
                                 data folder's dictionaries\. Nothing here is hardcoded, and it
                                 is hidden while there is only one to choose from. -->
                            <MenuItem x:Name="mDictionaryMenu" Header="Dictionar_y" Visibility="Collapsed"/>
                            <MenuItem x:Name="mReadAloudMenu" Header="Read A_loud">
                                <!-- Two groups: the voices to pick from, best first, then the
                                     windows that change settings. The two optional engines hide
                                     until installed (RefreshExtensionState); the Windows voices and
                                     the sampler are always there, so no separator is ever left
                                     dangling. -->
                                <!-- A voice like the others, so Read Aloud, Read and Read from here
                                     all use it. Filled in code with the saved narrator voices
                                     (QwenNarrator.SavedVoices); the one reading is ticked and named in
                                     the header. Hidden unless the narration environment is installed. -->
                                <!-- No tooltips on the voice submenus: a tooltip on a submenu header opens over the
                                     open submenu and hides an entry (2026-10-18). -->
                                <MenuItem x:Name="mQwenVoice" Header="_Qwen Narrator" Visibility="Collapsed"/>
                                <!-- The second, optional narrator (BreezeNarrator): the same Read Aloud,
                                     its own voices, including voices cloned from a recording. Hidden
                                     unless the Breeze extension is installed. -->
                                <MenuItem x:Name="mBreezeVoice" Header="_Breeze Narrator" Visibility="Collapsed"/>
                                <!-- The narrators' own tool, Narrator Manager. Help is in Help > Narration, once. -->
                                <MenuItem x:Name="mNarratorSettings" Header="_Narrator Manager..." Visibility="Collapsed"
                                          ToolTip="The narrator's voice and how it reads, new voices, and voices for this book's characters."/>
                                <Separator x:Name="sepNarrTools" Visibility="Collapsed"/>
                                <!-- The quick voices, and the sampler that plays them. -->
                                <!-- Filled in code from ExtensionCatalog.Voices, which is also what the
                                     installer downloads, so the menu cannot offer fewer voices than
                                     are on disk. Hidden until the extension is installed. -->
                                <MenuItem x:Name="mKokoroMenu" Header="_Kokoro Voices" Visibility="Collapsed"/>
                                <MenuItem x:Name="mWindowsVoices" Header="Windows _Installed Voices"/>
                                <MenuItem x:Name="mOnlineVoices" Header="Microsoft _Online Voices" Visibility="Collapsed"/>
                                <MenuItem x:Name="mConfigureSpeed" Header="_Configure Speed..."/>
                                <!-- What applies whatever the voice: Speed, Stop at end of chapter and Narration Monitor
                                     (every voice reports to it). Speed's steps are built in code (RebuildSpeedMenu). -->
                                <Separator/>
                                <MenuItem x:Name="mSpeedMenu" Header="_Speed"/>
                                <MenuItem x:Name="mStopAtChapter" Header="Stop at _end of chapter" IsCheckable="True"
                                          ToolTip="Finish this chapter and stop. In a book, the chapter named in the status bar. In a text or Markdown file, the section under the current heading. Remembered."/>
                                <MenuItem x:Name="mNarrMonitor" Header="Narration _Monitor" IsCheckable="True"
                                          ToolTip="A window that shows, as each piece plays, exactly what the voice was given: the text, the voice and the speed, and with a narrator who speaks, the instruction and the strength."/>
                            </MenuItem>
                            <!-- Access key t, not x: Exit already has x in this menu, and a
                                 shared access key cycles the highlight instead of opening. -->
                            <MenuItem x:Name="mExtensions" Header="Ex_tensions..."
                                      ToolTip="Optional downloads: neural voices, and a much larger dictionary"/>
                            <Separator/>
                            <MenuItem Header="Pri_vacy">
                                <!-- One switch instead of three: while it is on, nothing that
                                     names a document, its contents, its position or its history
                                     is written. View settings (window, theme, spacing) still are
                                     — they describe the app, not the reader. Forward-looking:
                                     it stops new writes and does not delete what is already
                                     stored; Clear Stored Data is still how you do that. -->
                                <MenuItem x:Name="mPrivacyMode" Header="_Privacy Mode" IsCheckable="True" IsChecked="False"
                                          ToolTip="Write nothing that names a document: no session, no reading positions, no bookmarks, no recent files, no autosave"/>
                                <Separator/>
                                <MenuItem x:Name="mSessionRestoreContent" Header="Remember _unsaved documents between sessions" IsCheckable="True" IsChecked="False"/>
                                <Separator/>
                                <MenuItem x:Name="mClearData" Header="_Clear Stored Data..."/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem x:Name="mExit" Header="E_xit" InputGestureText="Alt+F4"/>
                        </MenuItem>
                        <MenuItem x:Name="menuEdit" Header="_Edit">
                            <MenuItem x:Name="mUndo" Header="_Undo" InputGestureText="Ctrl+Z"/>
                            <MenuItem x:Name="mRedo" Header="_Redo" InputGestureText="Ctrl+Y"/>
                            <Separator/>
                            <!-- Shown on a PDF only (RefreshFileMenuAvailability). Changes go into
                                 the PDF when it is saved, unlike marks, which TypoZen keeps. -->
                            <MenuItem x:Name="menuAnnotate" Header="A_nnotate PDF" Visibility="Collapsed">
                                <MenuItem x:Name="mAnnHighlight" Header="_Highlight" IsCheckable="True"
                                          ToolTip="Drag across text to highlight it in the PDF"/>
                                <MenuItem x:Name="mAnnText" Header="Add _Text" IsCheckable="True"
                                          ToolTip="Click on the page to type a note onto it"/>
                                <MenuItem x:Name="mAnnDraw" Header="_Draw" IsCheckable="True"
                                          ToolTip="Draw on the page with the mouse or a pen"/>
                                <MenuItem x:Name="mAnnPicture" Header="Add _Picture..."
                                          ToolTip="Place an image on the page"/>
                                <Separator/>
                                <MenuItem x:Name="mAnnStop" Header="_Stop Annotating"
                                          ToolTip="Back to reading: select text, look words up"/>
                            </MenuItem>
                            <Separator x:Name="sepAnnotate" Visibility="Collapsed"/>
                            <MenuItem x:Name="mCut" Header="Cu_t" InputGestureText="Ctrl+X"/>
                            <MenuItem x:Name="mCopy" Header="_Copy" InputGestureText="Ctrl+C"/>
                            <MenuItem x:Name="mPaste" Header="_Paste" InputGestureText="Ctrl+V"/>
                            <MenuItem x:Name="mPastePlain" Header="Paste as Plain Te_xt" InputGestureText="Ctrl+Shift+V"/>
                            <MenuItem x:Name="mSelectAll" Header="Select _All" InputGestureText="Ctrl+A"/>
                            <Separator/>
                            <MenuItem x:Name="mFind" Header="_Find &amp; Replace..." InputGestureText="Ctrl+F"/>
                            <MenuItem x:Name="mGoToPage" Header="_Go to Page..." InputGestureText="Ctrl+G"/>
                            <Separator/>
                            <MenuItem x:Name="mMarkToggle" Header="Bookmar_k This Page" InputGestureText="Ctrl+Shift+M"/>
                            <MenuItem x:Name="mMarksPane" Header="Show Book_marks" InputGestureText="Ctrl+Shift+P"/>
                            <MenuItem x:Name="mReturnJump" Header="Return from _Jump" InputGestureText="Ctrl+Shift+J"/>
                        </MenuItem>
                        <!-- Every formatting command; filled from the same definition as the
                             right-click menu (AddFormatItems), so the two cannot drift. -->
                        <MenuItem x:Name="menuFormat" Header="F_ormat"/>
                        <MenuItem Header="_View">
                            <MenuItem x:Name="menuSidebarGroup" Header="_Sidebar (Alt+\)">
                                <MenuItem x:Name="mSidebarOutline" Header="_Outline"/>
                                <MenuItem x:Name="mSidebarSearch" Header="_Search" InputGestureText="Alt+S"/>
                                <MenuItem x:Name="mSidebarMarks" Header="_Marks"/>
                            </MenuItem>
                            <Separator/>

                            <MenuItem x:Name="mScrubberToggle" Header="Scr_ubber" IsCheckable="True" IsChecked="True"/>
                            <MenuItem x:Name="mStatusBarToggle" Header="Status _Bar" IsCheckable="True" IsChecked="True"/>
                            <MenuItem x:Name="mPdfThemeColours" Header="PDF Pages in Th_eme Colours" IsCheckable="True"
                                      ToolTip="Draw PDF pages in the theme's colours. Good for text; pictures are recoloured too."/>
                            <MenuItem x:Name="mPdfOcr" Header="Read Text in Scanned PDF Pa_ges" IsCheckable="True" IsChecked="True"
                                      ToolTip="Recognise the words on scanned pages with Windows' own text recognition, on this computer, so they can be searched, selected and read aloud. Handwriting and poor scans read badly."/>
                            <MenuItem x:Name="mChromeAutoHide" Header="_ZenMode (autohide UI)" IsCheckable="True"/>
                            <MenuItem x:Name="mSidebarAutoHide" Header="Side Panel Auto-_hide" IsCheckable="True" IsChecked="False"/>
                            <Separator/>

                            <MenuItem x:Name="mToggleFocus" Header="_Focus Mode" InputGestureText="F8" IsCheckable="True"/>
                            <MenuItem x:Name="mToggleTypewriter" Header="_Typewriter Scrolling" InputGestureText="F9" IsCheckable="True"/>
                            <MenuItem x:Name="mToggleReveal" Header="Re_veal Markdown on Focus" InputGestureText="F7" IsCheckable="True" IsChecked="False"/>
                            <MenuItem x:Name="menuFontAppearance" Header="F_ont Appearance">
                                <MenuItem Header="_Type">
                                    <MenuItem x:Name="mFontTheme" Header="_Theme" IsCheckable="True" IsChecked="True"/>
                                    <MenuItem x:Name="mFontSerif" Header="_Serif" IsCheckable="True"/>
                                    <MenuItem x:Name="mFontSans" Header="S_ans-Serif" IsCheckable="True"/>
                                </MenuItem>
                                <MenuItem Header="Si_ze">
                                    <MenuItem x:Name="mSizeExtraSmall" Header="E_xtra Small" IsCheckable="True"/>
                                    <MenuItem x:Name="mSizeSmall" Header="_Small" IsCheckable="True"/>
                                    <MenuItem x:Name="mSizeNormal" Header="_Normal" IsCheckable="True" IsChecked="True"/>
                                    <MenuItem x:Name="mSizeLarge" Header="_Large" IsCheckable="True"/>
                                    <MenuItem x:Name="mSizeExtraLarge" Header="Extra L_arge" IsCheckable="True"/>
                                </MenuItem>
                                <MenuItem x:Name="mFontCustom" Header="_Custom..." IsCheckable="True"/>
                            </MenuItem>
                            <MenuItem x:Name="menuSpacing" Header="S_pacing &amp; Margins">
                                <MenuItem Header="_Line Spacing">
                                    <MenuItem x:Name="mLineTight" Header="_Tight" IsCheckable="True"/>
                                    <MenuItem x:Name="mLineNormal" Header="_Normal" IsCheckable="True" IsChecked="True"/>
                                    <MenuItem x:Name="mLineRelaxed" Header="_Relaxed" IsCheckable="True"/>
                                    <MenuItem x:Name="mLineLoose" Header="_Loose" IsCheckable="True"/>
                                </MenuItem>
                                <MenuItem Header="_Paragraph Spacing">
                                    <MenuItem x:Name="mParaTight" Header="_Tight" IsCheckable="True"/>
                                    <MenuItem x:Name="mParaNormal" Header="_Normal" IsCheckable="True" IsChecked="True"/>
                                    <MenuItem x:Name="mParaRelaxed" Header="_Relaxed" IsCheckable="True"/>
                                    <MenuItem x:Name="mParaLoose" Header="_Loose" IsCheckable="True"/>
                                </MenuItem>
                                <MenuItem Header="_Margins">
                                    <MenuItem x:Name="mMarginNarrow" Header="_Narrow Margins" IsCheckable="True"/>
                                    <MenuItem x:Name="mMarginRegular" Header="_Regular Margins" IsCheckable="True" IsChecked="True"/>
                                    <MenuItem x:Name="mMarginWide" Header="_Wide Margins" IsCheckable="True"/>
                                </MenuItem>
                            </MenuItem>
                            <Separator/>

                            <MenuItem x:Name="mJustify" Header="_Justified" IsCheckable="True" IsChecked="False"/>
                            <MenuItem x:Name="mWordWrap" Header="_Word Wrap" IsCheckable="True" IsChecked="True"/>
                            <Separator/>

                            <MenuItem x:Name="menuZoomGroup" Header="Zoo_m">
                                <MenuItem x:Name="mZoomIn" Header="Zoom _In" InputGestureText="Ctrl++"/>
                                <MenuItem x:Name="mZoomOut" Header="Zoom _Out" InputGestureText="Ctrl+-"/>
                                <MenuItem x:Name="mZoomReset" Header="_Reset Zoom" InputGestureText="Ctrl+0"/>
                            </MenuItem>
                            <MenuItem x:Name="mFullscreen" Header="Fu_llscreen" InputGestureText="F11"/>
                            <Separator/>
                            <MenuItem x:Name="mResetView" Header="_Reset View Settings"/>
                        </MenuItem>
                        <MenuItem x:Name="mThemesMenu" Header="_Themes">
                            <!-- Dynamically populated from Themes JSON -->
                        </MenuItem>
                        <MenuItem x:Name="menuHelp" Header="_Help">
                            <MenuItem x:Name="mHelpGuide" Header="_User Guide" ToolTip="The full guide to TypoZen (README), opened in a tab"/>
                            <MenuItem x:Name="mHelpSyntax" Header="Syntax &amp; _Shortcuts" InputGestureText="F1"/>
                            <MenuItem x:Name="mHelpNarration" Header="_Narration" Visibility="Collapsed"/>
                            <MenuItem x:Name="mToggleDebug" Header="_Debug HUD" InputGestureText="Ctrl+Shift+D"/>
                            <Separator/>
                            <MenuItem x:Name="mAbout" Header="_About TypoZen"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <!-- No formatting on the command row (Ed, 2026-11-21): formatting is on the
                     right-click menu, where the text is. This row is for how you read and view. -->

                   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- One control: the speaker, Read Aloud, and Stop while reading. The other
                         controls of a reading are on the reading bar, at the bottom of the page
                         (09-speech.js, setReadBar). -->
                    <Border x:Name="grpReadAloud" Style="{StaticResource SegmentGroup}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnReadAloud" Style="{StaticResource SegmentButton}"
                                    Content="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                    ToolTip="Read Aloud"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ToolbarDivider}"/>

                    <!-- Phase 3A: Mode segmented control -->
                    <Border x:Name="grpMode" Style="{StaticResource SegmentGroup}" Margin="0"
                            ToolTip="Editing mode — Source, Preview or Reader">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnModeSource"  Style="{StaticResource SegmentButton}" Content="&#xE943;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" ToolTip="Source"/>
                            <Border   Style="{StaticResource SegmentDivider}"/>
                            <Button x:Name="btnModePreview" Style="{StaticResource SegmentButton}" Content="&#xE890;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" ToolTip="Preview"/>
                            <Border   Style="{StaticResource SegmentDivider}"/>
                            <Button x:Name="btnModeReader"  Style="{StaticResource SegmentButton}" Content="&#xE736;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" ToolTip="Reader"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ToolbarDivider}"/>

                    <!-- Same segment style as Source / Preview / Reader, with short captions so
                         1/2 columns and Scroll/Pages stay scannable at a glance. -->
                    <Border x:Name="grpColumns" Style="{StaticResource SegmentGroup}" Margin="0,0,6,0"
                            ToolTip="Column layout. Two columns use pages.">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnColumn1" Style="{StaticResource SegmentButton}"
                                    Content="1 Col" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
                                    MinWidth="44" Padding="8,2" ToolTip="One column"/>
                            <Border Style="{StaticResource SegmentDivider}"/>
                            <Button x:Name="btnColumn2" Style="{StaticResource SegmentButton}"
                                    Content="2 Col" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
                                    MinWidth="44" Padding="8,2" ToolTip="Two columns"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="grpScroll" Style="{StaticResource SegmentGroup}" Margin="0"
                            ToolTip="Scroll or pages">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnScrollScroll" Style="{StaticResource SegmentButton}"
                                    Content="Scroll" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
                                    MinWidth="46" Padding="8,2" ToolTip="Continuous scroll"/>
                            <Border Style="{StaticResource SegmentDivider}"/>
                            <Button x:Name="btnScrollPages" Style="{StaticResource SegmentButton}"
                                    Content="Pages" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
                                    MinWidth="46" Padding="8,2" ToolTip="Paginated pages"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar: quieter type with tabular numerals so the document stays primary. -->
        <Border x:Name="statusBar" DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Padding="12,4,12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="statusIndicator" Width="7" Height="7" CornerRadius="4" Background="#10B981" Margin="0,0,8,0" Opacity="0.85"/>
                    <TextBlock x:Name="lblStatus" Text="Ready" FontSize="11" FontWeight="Normal" Opacity="0.8" Margin="0,0,12,0"/>
                    <TextBlock x:Name="lblFilePath" Text="Untitled.md" FontSize="11" Opacity="0.75"
                               TextTrimming="CharacterEllipsis" MaxWidth="280"
                               Cursor="Hand" VerticalAlignment="Center"/>
                    <!-- Appears for a moment after File > Save or Ctrl+S. The chip beside
                         the dot stays Saved / Unsaved; this is the keypress, not the dirty flag. -->
                    <TextBlock x:Name="lblSaveNote" Text="Saved just now" FontSize="11" FontWeight="SemiBold"
                               Foreground="#10B981" Margin="12,0,0,0" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                    <!-- Shown for the rest of the run once an unexpected error has switched
                         autosave and session restore off (Program.DocumentStateSuspect). -->
                    <TextBlock x:Name="lblAutosaveOff" Text="&#x26A0; Autosave and session restore are off after an error"
                               FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                               ToolTip="An unexpected error stopped TypoZen trusting what is in memory to overwrite your files. Save anything you need with File &gt; Save As, then restart TypoZen."/>
                </StackPanel>

                <!-- The Read Aloud engine and voice, and what the Qwen narrator is doing while
                     the reader waits for it, after the file name, marked with the Read Aloud
                     button's own symbol so it reads as the narrator. Filled by UpdateVoiceStatus. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="16,0,12,0" Opacity="0.72"
                            ToolTip="Read Aloud voice. Change it in File > Read Aloud.">
                    <TextBlock x:Name="lblVoiceIcon" Text="" FontSize="12" Margin="0,1,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblVoice" Text="" FontSize="11" FontWeight="Normal"
                               TextTrimming="CharacterEllipsis" MaxWidth="260" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Which of these show, and in what order, depends on the document type
                     (ApplyStatusLayout): a book, a document or code, or a PDF. -->
                <StackPanel x:Name="statusCounts" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.72">
                    <TextBlock x:Name="lblChapter" Text="" FontSize="11" FontWeight="Normal" Margin="0,0,12,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="220"
                               Cursor="Hand" VerticalAlignment="Center"
                               ToolTip="Current chapter — click to jump to its start"/>
                    <TextBlock x:Name="lblProgress" Text="" FontSize="11" FontWeight="Normal" Typography.NumeralAlignment="Tabular" Margin="0,0,12,0"
                               Visibility="Collapsed" ToolTip="How far through the book, by words"/>
                    <TextBlock x:Name="lblWordCount" Text="0 words" FontSize="11" FontWeight="Normal" Typography.NumeralAlignment="Tabular" Margin="0,0,12,0" ToolTip="Word count (selection / document when text is selected)"/>
                    <TextBlock x:Name="lblLineCount" Text="Ln 1/1" FontSize="11" FontWeight="Normal" Typography.NumeralAlignment="Tabular" Margin="0,0,12,0" ToolTip="Current line / total lines"/>
                    <TextBlock x:Name="lblCharCount" Text="0 chars" FontSize="11" FontWeight="Normal" Typography.NumeralAlignment="Tabular" Margin="0,0,12,0" ToolTip="Character count (selection / document when text is selected)"/>
                    <TextBlock x:Name="lblReadingTime" Text="0 min read" FontSize="11" FontWeight="Normal" Typography.NumeralAlignment="Tabular" Margin="0,0,12,0"/>
                    <!-- Only shown when the file was not plain UTF-8. This used to be a
                         modal MessageBox on every such file opened, which interrupted a
                         read to announce a conversion that happens on save, offered no way
                         to decline it, and hid "never warn me again" behind a button
                         labelled No. The fact is worth stating; the interruption was not. -->
                    <TextBlock x:Name="lblEncoding" Text="" FontSize="11" FontWeight="Normal" Margin="0,0,12,0"
                               Visibility="Collapsed"
                               ToolTip="This file was not plain UTF-8. Saving rewrites it as UTF-8 without a BOM; your text is unchanged."/>
                    <TextBlock x:Name="lblZoom" Text="100%" FontSize="11" FontWeight="Normal" Typography.NumeralAlignment="Tabular" ToolTip="Editor zoom (Ctrl++ / Ctrl+- / Ctrl+0, or Ctrl+scroll)"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                    <Border x:Name="themeIndicatorBorder" CornerRadius="5" Padding="8,2"
                            Background="{DynamicResource TzSubtleFillBrush}">
                        <TextBlock x:Name="lblThemeName" Text="Theme: Nord" FontSize="11" FontWeight="Medium" Opacity="0.95"/>
                    </Border>
                </StackPanel>

                <!-- Column 4 is deliberately empty. It held a permanent "TypoZen v1.0",
                     which told the reader something they already knew, every second they
                     used the app, in the densest strip on screen. Help → About is the
                     place for product identity, when asked. -->
            </Grid>
        </Border>

        <!-- Main WebView2 Container -->
        <Border x:Name="webViewContainer" Background="#0F172A">
            <!-- WebView2 control will be dynamically injected here by C# code -->
        </Border>
    </DockPanel>
    </Grid>
</Window>



