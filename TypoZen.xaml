<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypoZen - WYSIWYG Markdown &amp; Text Editor" Height="780" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#0F172A" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuBarBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- Submenu Item Template -->
        <ControlTemplate x:Key="SubmenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="templateRoot" Background="Transparent" CornerRadius="4" Padding="10,6" Margin="4,1" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <ContentPresenter x:Name="iconPresenter" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="checkMark" Text="✓" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" FontWeight="Bold"/>

                    <ContentPresenter x:Name="headerPresenter" Grid.Column="1" ContentSource="Header" Margin="4,0,16,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    
                    <TextBlock x:Name="gestureText" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="16,0,4,0" VerticalAlignment="Center" Opacity="0.6"/>
                    <TextBlock x:Name="subMenuArrow" Grid.Column="2" Text="▶" FontSize="10" Margin="16,0,4,0" VerticalAlignment="Center" Visibility="Collapsed" Opacity="0.6"/>

                    <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" Focusable="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border x:Name="SubMenuBorder" Background="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="4,0,8,8" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Opacity="0.3" ShadowDepth="3" Color="#000000"/>
                            </Border.Effect>
                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter TargetName="gestureText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="subMenuArrow" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                    <Setter TargetName="gestureText" Property="Opacity" Value="0.95"/>
                    <Setter TargetName="subMenuArrow" Property="Opacity" Value="0.95"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="templateRoot" Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Top Level Header Template -->
        <ControlTemplate x:Key="TopLevelHeaderTemplate" TargetType="MenuItem">
            <Border x:Name="templateRoot" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="4" Padding="9,4" Margin="2,0" SnapsToDevicePixels="True">
                <Grid>
                    <ContentPresenter x:Name="headerPresenter" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" Focusable="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border x:Name="SubMenuBorder" Background="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,4,8,8" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Opacity="0.3" ShadowDepth="3" Color="#000000"/>
                            </Border.Effect>
                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <!-- Theme accent hover (same key as GhostToolbarButton). -->
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="MenuItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource TopLevelHeaderTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource TopLevelHeaderTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
            <Setter Property="Margin" Value="32,5,12,5"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" Margin="{TemplateBinding Margin}" Opacity="0.3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Quiet format tools. REVERT pack: GhostToolbarButton + ToolMenuHeaderTemplate + ToolbarMenuItem. -->
        <Style x:Key="GhostToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- H / list / table dropdowns: same hit box + accent hover as GhostToolbarButton -->
        <ControlTemplate x:Key="ToolMenuHeaderTemplate" TargetType="MenuItem">
            <Border x:Name="templateRoot" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="4" Padding="6,4" MinHeight="28" MinWidth="30" SnapsToDevicePixels="True">
                <Grid>
                    <ContentPresenter x:Name="headerPresenter" ContentSource="Header"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           Placement="Bottom" Focusable="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource {x:Static SystemColors.MenuBrushKey}}"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,4,8,8" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Opacity="0.3" ShadowDepth="3" Color="#000000"/>
                            </Border.Effect>
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="ToolbarMenuItem" TargetType="MenuItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template" Value="{StaticResource ToolMenuHeaderTemplate}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
        </Style>
    </Window.Resources>

    <!--
      rootChrome: full window. contentRoot inset leaves a thin WPF strip around the edges
      so WindowChrome resize works. WebView2 (WinForms HWND) otherwise covers the client
      and steals edge hits — only corners/status bar used to resize.
    -->
    <Grid x:Name="rootChrome">
    <DockPanel x:Name="contentRoot" Margin="6">
        <!--
          Notepad-style chrome (Option B):
            tabBar — title-bar band: document tabs + custom min/max/close
            topToolbar — command row: File/Edit/… + format icons + Sidebar / Preview
          WindowChrome is applied from C#. Empty title space must NOT be hit-testable in
          chrome so the window can be dragged; only tabs and caption buttons opt in.
        -->
        <!--
          Seam is a Rectangle BEHIND the tabs (not Border.BorderThickness). That way the
          active tab can paint over the line; a Border's stroke sits outside the child
          arrange rect and can never be covered.
        -->
        <Border x:Name="tabBar" DockPanel.Dock="Top" Height="36" BorderThickness="0" Padding="8,0,0,0"
                ClipToBounds="False">
            <Grid ClipToBounds="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Full-width seam under the tab row; themed in C#. -->
                <Rectangle x:Name="tabSeam" Grid.Column="0" Grid.ColumnSpan="2"
                           Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
                <!-- Notepad-style: no fat Auto scrollbar in the title band. Overflow uses
                     shrink-to-fit + mouse-wheel / optional arrow scroll (wired in C#). -->
                <Grid Grid.Column="0" Margin="0,0,4,0" ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnTabScrollLeft" Grid.Column="0" Content="‹" FontSize="14" FontWeight="Bold"
                            Width="22" BorderThickness="0" Background="Transparent" Padding="0"
                            VerticalAlignment="Top" Margin="0,5,0,0" Height="24"
                            ToolTip="Scroll tabs left" Visibility="Collapsed"/>
                    <ScrollViewer x:Name="tabScroller" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False" VerticalAlignment="Stretch"
                                  ClipToBounds="False" PanningMode="HorizontalOnly">
                        <StackPanel x:Name="tabStrip" Orientation="Horizontal" VerticalAlignment="Top"
                                    Margin="0,5,0,0"/>
                    </ScrollViewer>
                    <Button x:Name="btnTabScrollRight" Grid.Column="2" Content="›" FontSize="14" FontWeight="Bold"
                            Width="22" BorderThickness="0" Background="Transparent" Padding="0"
                            VerticalAlignment="Top" Margin="0,5,0,0" Height="24"
                            ToolTip="Scroll tabs right" Visibility="Collapsed"/>
                </Grid>
                <StackPanel x:Name="captionButtons" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Stretch">
                    <Button x:Name="btnWinMin" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="46" BorderThickness="0" Background="Transparent" Padding="0"
                            ToolTip="Minimize"/>
                    <Button x:Name="btnWinMax" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="46" BorderThickness="0" Background="Transparent" Padding="0"
                            ToolTip="Maximize"/>
                    <Button x:Name="btnWinClose" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="46" BorderThickness="0" Background="Transparent" Padding="0"
                            ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="topToolbar" DockPanel.Dock="Top" BorderThickness="0,0,0,1" Padding="4,2,8,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Menu x:Name="topMenu" Grid.Column="0" Background="Transparent" Padding="2,0" VerticalAlignment="Center">
                    <MenuItem Header="_File">
                        <MenuItem x:Name="mNew" Header="_New" InputGestureText="Ctrl+N"/>
                        <MenuItem x:Name="mOpen" Header="_Open..." InputGestureText="Ctrl+O"/>
                        <MenuItem x:Name="mRecentMenu" Header="Open _Recent">
                            <MenuItem Header="(none)" IsEnabled="False"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem x:Name="mSave" Header="_Save" InputGestureText="Ctrl+S"/>
                        <MenuItem x:Name="mSaveAs" Header="Save _As..." InputGestureText="Ctrl+Shift+S"/>
                        <Separator/>
                        <MenuItem x:Name="mExportHtml" Header="Export as _HTML..."/>
                        <MenuItem x:Name="mExportPdf" Header="_Print / Export PDF..." InputGestureText="Ctrl+P"/>
                        <Separator/>
                        <MenuItem Header="Pri_vacy">
                            <MenuItem x:Name="mSessionRestoreContent" Header="Remember _unsaved documents between sessions" IsCheckable="True" IsChecked="False"/>
                            <MenuItem x:Name="mRecentEnabled" Header="Keep _recent files list" IsCheckable="True" IsChecked="True"/>
                            <Separator/>
                            <MenuItem x:Name="mClearData" Header="_Clear Stored Data..."/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem x:Name="mExit" Header="E_xit" InputGestureText="Alt+F4"/>
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem x:Name="mUndo" Header="_Undo" InputGestureText="Ctrl+Z"/>
                        <MenuItem x:Name="mRedo" Header="_Redo" InputGestureText="Ctrl+Y"/>
                        <Separator/>
                        <MenuItem x:Name="mCut" Header="Cu_t" InputGestureText="Ctrl+X"/>
                        <MenuItem x:Name="mCopy" Header="_Copy" InputGestureText="Ctrl+C"/>
                        <MenuItem x:Name="mPaste" Header="_Paste" InputGestureText="Ctrl+V"/>
                        <Separator/>
                        <MenuItem x:Name="mFind" Header="_Find &amp; Replace..." InputGestureText="Ctrl+F"/>
                        <Separator/>
                        <MenuItem x:Name="mInsertLink" Header="Insert _Link" InputGestureText="Ctrl+K"/>
                        <MenuItem x:Name="mInsertTable" Header="Insert _Table" InputGestureText="Ctrl+T"/>
                        <MenuItem x:Name="mStrike" Header="Strike_through" InputGestureText="Ctrl+Shift+X"/>
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem x:Name="mToggleSource" Header="Toggle _Source Mode" InputGestureText="Ctrl+/"/>
                        <MenuItem x:Name="mToggleSidebar" Header="Toggle _Sidebar (Outline/Files)" InputGestureText="Ctrl+\"/>
                        <Separator/>
                        <MenuItem x:Name="mToggleReveal" Header="_Reveal Markdown on Focus" InputGestureText="F7" IsCheckable="True" IsChecked="False"/>
                        <MenuItem x:Name="mToggleFocus" Header="_Focus Mode" InputGestureText="F8" IsCheckable="True"/>
                        <MenuItem x:Name="mToggleTypewriter" Header="_Typewriter Scrolling" InputGestureText="F9" IsCheckable="True"/>
                        <Separator/>
                        <MenuItem Header="_Editor Margins">
                            <MenuItem x:Name="mMarginNarrow" Header="_Narrow Margins" IsCheckable="True"/>
                            <MenuItem x:Name="mMarginRegular" Header="_Regular Margins" IsCheckable="True" IsChecked="True"/>
                            <MenuItem x:Name="mMarginWide" Header="_Wide Margins" IsCheckable="True"/>
                        </MenuItem>
                        <Separator/>
                        <!-- Hides command bar + tab chips while writing; slim caption (drag/─□×) stays. Pointer to top or Alt restores. -->
                        <MenuItem x:Name="mChromeAutoHide" Header="_Auto-hide menu" IsCheckable="True"/>
                        <MenuItem x:Name="mWordWrap" Header="_Word Wrap" IsCheckable="True" IsChecked="True"/>
                        <MenuItem x:Name="mStatusBarToggle" Header="Status _Bar" IsCheckable="True" IsChecked="True"/>
                        <Separator/>
                        <MenuItem x:Name="mZoomIn" Header="Zoom _In" InputGestureText="Ctrl++"/>
                        <MenuItem x:Name="mZoomOut" Header="Zoom _Out" InputGestureText="Ctrl+-"/>
                        <MenuItem x:Name="mZoomReset" Header="_Reset Zoom" InputGestureText="Ctrl+0"/>
                        <Separator/>
                        <MenuItem x:Name="mFullscreen" Header="Toggle _Fullscreen" InputGestureText="F11"/>
                    </MenuItem>
                    <MenuItem x:Name="mThemesMenu" Header="_Themes">
                        <!-- Dynamically populated from Themes JSON -->
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem x:Name="mHelpSyntax" Header="Markdown _Syntax Guide" InputGestureText="F1"/>
                        <Separator/>
                        <MenuItem x:Name="mAbout" Header="_About TypoZen"/>
                    </MenuItem>
                </Menu>

                <!-- Format tools: even MinHeight 28 hit targets; REVERT pack tags above. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <!-- Inline -->
                    <Button x:Name="btnBold" Style="{StaticResource GhostToolbarButton}" Content="B" FontWeight="Bold" FontFamily="Segoe UI"
                            Margin="0,0,2,0" ToolTip="Bold (Ctrl+B)"/>
                    <Button x:Name="btnItalic" Style="{StaticResource GhostToolbarButton}" Content="I" FontStyle="Italic" FontFamily="Segoe UI"
                            Margin="0,0,2,0" ToolTip="Italic (Ctrl+I)"/>
                    <Button x:Name="btnStrike" Style="{StaticResource GhostToolbarButton}" Margin="0,0,2,0" ToolTip="Strikethrough (Ctrl+Shift+X)">
                        <TextBlock Text="S" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" TextDecorations="Strikethrough"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="btnCode" Style="{StaticResource GhostToolbarButton}" Content="&lt;/&gt;"
                            FontFamily="Consolas, Cascadia Mono, Segoe UI" FontSize="12"
                            MinWidth="32" Margin="0,0,12,0" ToolTip="Inline Code"/>

                    <!-- Block — same hit box + accent hover as B/I -->
                    <Menu x:Name="headingMenu" Background="Transparent" Padding="0" Margin="0,0,2,0" VerticalAlignment="Center">
                        <MenuItem x:Name="miHeadings" Style="{StaticResource ToolbarMenuItem}"
                                  Header="H  &#x25BE;" FontFamily="Segoe UI" FontWeight="SemiBold" ToolTip="Headings (H1-H6)">
                            <MenuItem x:Name="btnH1" Header="Heading _1"/>
                            <MenuItem x:Name="btnH2" Header="Heading _2"/>
                            <MenuItem x:Name="btnH3" Header="Heading _3"/>
                            <MenuItem x:Name="btnH4" Header="Heading _4"/>
                            <MenuItem x:Name="btnH5" Header="Heading _5"/>
                            <MenuItem x:Name="btnH6" Header="Heading _6"/>
                        </MenuItem>
                    </Menu>
                    <Button x:Name="btnQuote" Style="{StaticResource GhostToolbarButton}" Content="&#x201C;"
                            FontFamily="Georgia, 'Times New Roman', serif" FontSize="15" FontWeight="SemiBold"
                            Margin="0,0,2,0" ToolTip="Blockquote"/>
                    <Menu x:Name="listMenu" Background="Transparent" Padding="0" Margin="0,0,12,0" VerticalAlignment="Center">
                        <MenuItem x:Name="miLists" Style="{StaticResource ToolbarMenuItem}" ToolTip="Lists">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text=" &#x25BE;" FontFamily="Segoe UI" FontSize="10" VerticalAlignment="Center" Opacity="0.7"/>
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem x:Name="btnList" Header="_Bulleted list" FontFamily="Segoe UI"/>
                            <MenuItem x:Name="btnOrderedList" Header="_Numbered list" FontFamily="Segoe UI"/>
                            <MenuItem x:Name="btnChecklist" Header="_Task checklist" FontFamily="Segoe UI"/>
                        </MenuItem>
                    </Menu>

                    <!-- Inserts -->
                    <Button x:Name="btnLink" Style="{StaticResource GhostToolbarButton}" Content="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Margin="0,0,2,0" ToolTip="Insert link (Ctrl+K)"/>
                    <Menu x:Name="tableMenu" Background="Transparent" Padding="0" Margin="0,0,0,0" VerticalAlignment="Center">
                        <MenuItem x:Name="miTable" Style="{StaticResource ToolbarMenuItem}" ToolTip="Table">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text=" &#x25BE;" FontFamily="Segoe UI" FontSize="10" VerticalAlignment="Center" Opacity="0.7"/>
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem x:Name="btnTable" Header="_Insert table..." InputGestureText="Ctrl+T"/>
                            <MenuItem x:Name="btnTableCustom" Header="Custom _size..."/>
                            <Separator/>
                            <MenuItem x:Name="mTblRowAbove" Header="Insert row _above"/>
                            <MenuItem x:Name="mTblRowBelow" Header="Insert row _below"/>
                            <MenuItem x:Name="mTblRowDelete" Header="_Delete row"/>
                            <Separator/>
                            <MenuItem x:Name="mTblColLeft" Header="Insert column _left"/>
                            <MenuItem x:Name="mTblColRight" Header="Insert column _right"/>
                            <MenuItem x:Name="mTblColDelete" Header="Delete _column"/>
                            <Separator/>
                            <MenuItem Header="Align col_umn">
                                <MenuItem x:Name="mTblAlignLeft" Header="_Left"/>
                                <MenuItem x:Name="mTblAlignCenter" Header="_Center"/>
                                <MenuItem x:Name="mTblAlignRight" Header="_Right"/>
                                <MenuItem x:Name="mTblAlignNone" Header="_Default"/>
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnToggleSidebar" Style="{StaticResource GhostToolbarButton}"
                            FontFamily="Segoe MDL2 Assets" Content="&#xE8A0;" FontSize="14"
                            MinWidth="32" Padding="6,2" Margin="0,0,6,0"
                            ToolTip="Toggle File Tree &amp; Outline (Ctrl+\)"/>
                    <Button x:Name="btnToggleColumnMode" Style="{StaticResource GhostToolbarButton}" Content="1 Col"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="1" FontWeight="Normal" MinWidth="50" Padding="10,4" Margin="0,0,6,0"
                            Visibility="Collapsed"
                            ToolTip="Toggle between Single and Double column reader layout"/>
                    <Button x:Name="btnToggleScrollMode" Style="{StaticResource GhostToolbarButton}" Content="Scroll"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="1" FontWeight="Normal" MinWidth="60" Padding="10,4" Margin="0,0,6,0"
                            ToolTip="Toggle between continuous Scroll and Page Advance"/>
                    <!-- Ghost mode: stronger idle outline so it reads on light themes (C# also themes border). -->
                    <Button x:Name="btnToggleMode" Style="{StaticResource GhostToolbarButton}" Content="Preview"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="1" FontWeight="Normal" MinWidth="76" Padding="10,4"
                            ToolTip="Editing mode — click to switch Preview / Source (Ctrl+/)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar: quieter type so the document stays primary. REVERT: restore Padding 12,6 + SemiBold. -->
        <Border x:Name="statusBar" DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="statusIndicator" Width="7" Height="7" CornerRadius="4" Background="#10B981" Margin="0,0,8,0" Opacity="0.85"/>
                    <TextBlock x:Name="lblStatus" Text="Ready" FontSize="11" FontWeight="Normal" Opacity="0.8" Margin="0,0,12,0"/>
                    <TextBlock x:Name="lblFilePath" Text="Untitled.md" FontSize="11" Opacity="0.75"
                               TextTrimming="CharacterEllipsis" MaxWidth="280"
                               Cursor="Hand" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.72">
                    <TextBlock x:Name="lblWordCount" Text="0 words" FontSize="11" FontWeight="Normal" Margin="0,0,12,0" ToolTip="Word count (selection / document when text is selected)"/>
                    <TextBlock x:Name="lblLineCount" Text="Ln 1/1" FontSize="11" FontWeight="Normal" Margin="0,0,12,0" ToolTip="Current line / total lines"/>
                    <TextBlock x:Name="lblCharCount" Text="0 chars" FontSize="11" FontWeight="Normal" Margin="0,0,12,0" ToolTip="Character count (selection / document when text is selected)"/>
                    <TextBlock x:Name="lblReadingTime" Text="0 min read" FontSize="11" FontWeight="Normal" Margin="0,0,12,0"/>
                    <TextBlock x:Name="lblZoom" Text="100%" FontSize="11" FontWeight="Normal" ToolTip="Editor zoom (Ctrl++ / Ctrl+- / Ctrl+0, or Ctrl+scroll)"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Border x:Name="themeIndicatorBorder" CornerRadius="4" Padding="7,1" Background="#1E293B" Opacity="0.85">
                        <TextBlock x:Name="lblThemeName" Text="Theme: Nord" FontSize="10" FontWeight="Normal" Opacity="0.9"/>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="lblVersion" Grid.Column="4" Text="TypoZen v1.0" FontSize="10" Opacity="0.55" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main WebView2 Container -->
        <Border x:Name="webViewContainer" Background="#0F172A">
            <!-- WebView2 control will be dynamically injected here by C# code -->
        </Border>
    </DockPanel>
    </Grid>
</Window>
