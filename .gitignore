# Dependencies
node_modules/

# Build intermediates
obj/
bin/
*.pdb

# Staging for content handed to the page: document bodies and book payloads are written
# here and fetched over the local origin, because a 40,000-block book is not something to
# push through the message channel. Swept by PruneLoadStageDir.
typozen_load/

# Runtime logs
debug.log

# Generated jsdom fixture -- rebuilt from TypoZen_Template.html + css + js by
# tests/build-test-template.mjs on every test run and every build.
TypoZen_Template_Test.html

# Stamped at launch with ?v= on script/css tags so WebView cannot cache stale modules.
TypoZen_Template.runtime.html

# Test books. Real novels, used because a converter that looks fine on a synthetic
# fixture is exactly how the current one shipped losing every image and link.
tests/*.epub

# Extracted books: a per-book asset cache, rebuilt on demand.
typozen_books/

# Scratch output from tests/tabs-content-e2e.py (includes a WebView2 profile).
tests/_tab_e2e_out/

# Written and removed by tests/bookmark-store-app.mjs; left behind only if it crashes.
tests/_bookmark_fixture.md

# WordNet, downloaded by hand and converted by tools/Make-Dictionary.ps1. 90 MB of source
# corpus that is not this project's to redistribute -- Princeton's licence requires the
# terms to travel with it, and the built dictionary.tsv lives in the cache anyway.
WordNet-3.0/
wn3.1.dict/
WNdb-*/
dictionary.tsv
dictionary.json
